
config igmpproxy
	option quickleave '1'

config phyint
	option network 'wan'
	option zone 'wan'
	option direction 'upstream'
	# SFR multicast sources are outside the 192.168.100.0/24 WAN subnet
	list altnet '0.0.0.0/0'

config phyint
	option network 'lan'
	option zone 'lan'
	option direction 'downstream'
